index 0000000..553e6df
--- /dev/null
+++ b/apps/student/src/main/java/com/hamyareman/ir/ui/study/BundledMathPractice.kt
@@ -0,0 +1,44 @@
+package com.hamyareman.ir.ui.study
+
+import android.content.Context
+import org.json.JSONObject
+
+/** Explicit bucket-to-asset routes shipped only by the matching grade module. */
+internal object BundledMathPractice {
+    data class Route(val bucketKey: String, val assetPath: String, val packId: String, val kind: String)
+
+    private const val ASSET_PREFIX = "file:///android_asset/"
+    private const val CONTENT_PREFIX = "math/c905/practice/"
+
+    @Volatile private var routes: List<Route>? = null
+
+    internal fun parse(raw: String): List<Route> {
+        val array = JSONObject(raw).getJSONArray("routes")
+        return (0 until array.length()).map { index ->
+            val item = array.getJSONObject(index)
+            Route(item.getString("bucketKey"), item.getString("assetPath"), item.getString("packId"), item.getString("kind")).also {
+                require(it.bucketKey.startsWith("Bucket/Html-files/app/books/C905/"))
+                require(it.assetPath.startsWith(CONTENT_PREFIX) && it.assetPath.endsWith(".html"))
+                require(it.assetPath.matches(Regex("[A-Za-z0-9._/-]+")))
+                require(it.assetPath.split('/').none { part -> part == ".." || part == "." })
+                require(it.packId.matches(Regex("C905_E[0-9]{2}-SUM")))
+                require(it.kind in setOf("summary", "flash", "exam"))
+            }
+        }.also { require(it.map(Route::bucketKey).distinct().size == it.size) }
+    }
+
+    private fun all(context: Context): List<Route> = routes ?: synchronized(this) {
+        routes ?: runCatching {
+            context.applicationContext.assets.open("content/math-practice-routes.json")
+                .bufferedReader().use { parse(it.readText()) }
+        }.getOrDefault(emptyList()).also { routes = it }
+    }
+
+    fun forBucket(context: Context, bucketKey: String): Route? = all(context).firstOrNull { it.bucketKey == bucketKey }
+
+    fun forAssetUrl(context: Context, url: String): Route? {
+        if (!url.startsWith(ASSET_PREFIX)) return null
+        val path = url.removePrefix(ASSET_PREFIX).substringBefore('#').substringBefore('?')
+        return all(context).firstOrNull { it.assetPath == path }
+    }
+}
