new file mode 100644
index 0000000..f46f45e
--- /dev/null
+++ b/apps/student/src/test/java/com/hamyareman/ir/ui/study/BundledMathPracticeTest.kt
@@ -0,0 +1,24 @@
+package com.hamyareman.ir.ui.study
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Test
+
+class BundledMathPracticeTest {
+    private fun payload(asset: String) = """{"routes":[{"bucketKey":"Bucket/Html-files/app/books/C905/N2.5/TAB05.html","assetPath":"$asset","packId":"C905_E01-SUM","kind":"exam"}]}"""
+
+    @Test fun `canonical route preserves pack and kind`() {
+        val route = BundledMathPractice.parse(payload("math/c905/practice/N2.5/TAB05.html")).single()
+        assertEquals("C905_E01-SUM", route.packId)
+        assertEquals("exam", route.kind)
+    }
+
+    @Test fun `route cannot escape bundled practice assets`() {
+        assertThrows(IllegalArgumentException::class.java) {
+            BundledMathPractice.parse(payload("math/c905/practice/../../private.html"))
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            BundledMathPractice.parse(payload("https://example.com/exam.html"))
+        }
+    }
+}
