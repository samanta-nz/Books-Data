      "source_max_F0": 275.6932188656469,
      "adjusted_max_F0": 220.5545750925175,
      "gain": 1.0
    },
    {
      "id": "p6s06",
      "text": "اگه بعد از تمرین هنوز ناآروم بودی، تمرین رو کنار بذار و به یه چیز واقعی اطرافت نگاه کن.",
      "source_pause_seconds": 3,
      "start_seconds": 402.97,
      "speech_samples": 189120,
