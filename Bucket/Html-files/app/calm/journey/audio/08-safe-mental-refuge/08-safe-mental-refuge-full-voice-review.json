      "start_seconds": 43.68,
      "speech_samples": 241920,
      "source_archive": "source-clips-batch01.zip",
      "source_max_F0": 302.0915426253838,
      "adjusted_max_F0": 241.673234100307,
      "gain": 1.0
    },
    {
      "id": "p1s05",
      "text": "شونه‌هات رو یه بار بالا ببر و با بازدم رها کن.",
