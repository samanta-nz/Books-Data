      "start_seconds": 67.8,
      "speech_samples": 106560,
      "source_archive": "source-clips-batch02.zip",
      "source_max_F0": 252.838688791581,
      "adjusted_max_F0": 202.2709510332648,
      "gain": 1.0
    },
    {
