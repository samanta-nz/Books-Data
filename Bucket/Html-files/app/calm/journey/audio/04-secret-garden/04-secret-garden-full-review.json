      "source_pause_seconds": 10,
      "start_seconds": 585.64,
      "speech_samples": 48960,
      "source_archive": "source-clips-part01-06-breath-and-corrections.zip",
      "source_max_F0": 112.1373453941882,
      "adjusted_max_F0": 89.70987631535057,
      "gain": 1.0
    },
    {
      "id": "p4s01",
      "text": "حالا بذار بقیه‌ی حس‌هات هم بیدار بشن.",
      "source_pause_seconds": 4,
