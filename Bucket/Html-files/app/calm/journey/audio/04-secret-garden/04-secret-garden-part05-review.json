      "source_max_F0": 319.20415195991484,
      "adjusted_max_F0": 255.36332156793188
    },
    {
      "id": "p5s12",
      "text": "برمی‌گردی روی نیمکت. آفتاب روی دست‌هاته.",
      "start_seconds": 200.2,
      "speech_samples": 123840,
      "source_pause_samples": 240000,
      "source_max_F0": 203.84081401445786,
      "adjusted_max_F0": 163.0726512115663
