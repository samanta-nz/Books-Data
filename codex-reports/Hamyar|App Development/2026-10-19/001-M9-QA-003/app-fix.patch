diff --git a/core/core-common/src/test/java/com/hamyareman/ir/platform/core/common/LocalStoreAccountIsolationTest.kt b/core/core-common/src/test/java/com/hamyareman/ir/platform/core/common/LocalStoreAccountIsolationTest.kt
